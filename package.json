{
  "name": "duhtron-desktop",
  "productName": "DuhTron",
  "version": "1.0.0",
  "description": "DuhTron - Deficienza Artificiale: l'intelligenza che ha deciso di non applicarsi.",
  "author": "DuhTron <info@duhtron.com>",
  "homepage": "https://duhtron.com",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.duhtron.app",
    "productName": "DuhTron",
    "files": ["main.js", "offline.html", "build/icon.png"],
    "directories": { "buildResources": "build", "output": "dist" },
    "compression": "maximum",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "DuhTron-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": true,
      "license": null
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "category": "public.app-category.entertainment",
      "artifactName": "DuhTron-${version}-Mac.${ext}"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Game",
      "maintainer": "info@duhtron.com",
      "artifactName": "DuhTron-${version}-Linux.${ext}",
      "synopsis": "Chiedi qualsiasi cosa. Le risposte sono il problema."
    },
    "publish": { "provider": "github", "owner": "danilofaillii", "repo": "duhtron-desktop" }
  }
}
